{
  "schema": "admin.json.docs/v1",
  "title": "admin.json field reference",
  "description": "Machine-readable inventory of every field in admin.json, generated by grepping the code for getAdminInfo() field usage. Human-readable version: ADMIN_FIELDS.md. The hidden remote-admin list URL is intentionally not part of this file.",
  "version": 1,
  "generator": {
    "method": "grep",
    "scope": [
      "Script/**/*.js",
      "includes/**/*.js",
      "utils/**/*.js",
      "Cyber.js"
    ],
    "commands": [
      "grep -rhoE \"getAdminInfo\\(\\)\\.[A-Za-z0-9_.]+|getAdminInfo\\(['\\\"][A-Za-z0-9_]+['\\\"]\\)\" --include=*.js Script includes utils Cyber.js | sort -u",
      "grep -rn \"= getAdminInfo()\" --include=*.js Script includes Cyber.js",
      "grep -rn \"permissions\\.\\|mergeAdminUids\\|normalizeAdminInfo\" --include=*.js utils Cyber.js"
    ]
  },
  "files": {
    "live": "admin.json",
    "template": "admin.json.example",
    "loader": "utils/adminInfo.js",
    "docs": "ADMIN_FIELDS.md"
  },
  "format": "json",
  "rootType": "object",
  "allFieldsOptional": true,
  "unknownKeys": "ignored",
  "validation": {
    "stringFields": "trimmed; placeholder-looking values ('Your ...', '<...>', '[...]') are treated as empty",
    "numberFields": "age may be a finite number and is coerced to a string",
    "uidPattern": "^\\d{5,20}$",
    "uidFields": [
      "avatar.uid",
      "social.facebookUid",
      "permissions.adminUids[]",
      "permissions.ownerUids[]"
    ],
    "nicknameFallback": "name",
    "facebookSync": "social.facebook and social.facebookUid are derived from each other when only one is supplied"
  },
  "fallbackBehavior": "A missing or malformed admin.json never stops the bot. The loader returns empty identity values and each command keeps its original hardcoded fallback.",
  "fields": {
    "_readme": {
      "type": "string",
      "default": null,
      "usedBy": [],
      "status": "metadata",
      "description": "Pointer to ADMIN_FIELDS.md and admin.json.docs.json. Ignored by the loader."
    },
    "name": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Cyber.js",
        "Script/commands/admin.js",
        "Script/commands/adbot.js",
        "Script/commands/allbox.js",
        "Script/commands/autoban.js",
        "Script/commands/birthday.js",
        "Script/commands/bot.js",
        "Script/commands/help.js",
        "Script/commands/helpall.js",
        "Script/commands/info.js",
        "Script/commands/info2.js",
        "Script/commands/minari.js"
      ],
      "description": "Display name of the owner / admin."
    },
    "nickname": {
      "type": "string",
      "default": "",
      "fallsBackTo": "name",
      "usedBy": [
        "Script/commands/bot.js",
        "Script/commands/cbto.js",
        "Script/commands/info2.js",
        "Script/commands/minari.js"
      ],
      "description": "Short name used in chat replies."
    },
    "legalName": {
      "type": "string",
      "default": "",
      "usedBy": [],
      "status": "reserved",
      "description": "Stored but not rendered by any command."
    },
    "gender": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js"
      ],
      "description": "Owner gender line."
    },
    "relationship": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js"
      ],
      "description": "Owner relationship line."
    },
    "age": {
      "type": "string | number",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js"
      ],
      "description": "Owner age line; finite numbers are coerced to strings."
    },
    "religion": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js"
      ],
      "description": "Owner religion line."
    },
    "education": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js"
      ],
      "description": "Owner education line."
    },
    "address": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js",
        "Script/commands/minari.js"
      ],
      "description": "Owner location / chatbot birthplace."
    },
    "birthday": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/birthday.js"
      ],
      "description": "Date string parsable by Date.parse, e.g. 'September 12, 2025 00:00:00'."
    },
    "avatar.uid": {
      "type": "string",
      "format": "uid",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js",
        "Script/commands/adbot.js",
        "Script/commands/birthday.js",
        "Script/commands/help.js"
      ],
      "description": "Facebook UID used to build the Graph profile-picture URL."
    },
    "avatar.url": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js",
        "Script/commands/adbot.js",
        "Script/commands/birthday.js"
      ],
      "description": "Explicit avatar image URL; takes precedence over avatar.uid."
    },
    "social.facebook": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js",
        "Script/commands/adbot.js",
        "Script/commands/bot.js",
        "Script/commands/cbto.js",
        "Script/commands/info.js",
        "Script/commands/info2.js"
      ],
      "description": "Facebook profile / inbox link."
    },
    "social.facebookUid": {
      "type": "string",
      "format": "uid",
      "default": "",
      "derivedFrom": "social.facebook",
      "usedBy": [
        "Script/commands/help.js"
      ],
      "description": "Facebook UID used for owner mentions."
    },
    "social.telegram": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js",
        "Script/commands/info2.js"
      ],
      "description": "Telegram link."
    },
    "social.tiktok": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/admin.js",
        "Script/commands/info2.js"
      ],
      "description": "TikTok handle."
    },
    "social.github": {
      "type": "string",
      "default": "",
      "usedBy": [],
      "status": "reserved",
      "description": "Stored but not rendered by any command."
    },
    "social.youtube": {
      "type": "string",
      "default": "",
      "usedBy": [],
      "status": "reserved",
      "description": "Stored but not rendered by any command."
    },
    "social.whatsapp": {
      "type": "string",
      "default": "",
      "usedBy": [
        "Script/commands/bot.js",
        "Script/commands/info.js"
      ],
      "description": "WhatsApp number shown to users."
    },
    "permissions.adminUids": {
      "type": "array<string>",
      "format": "uid",
      "default": [],
      "usedBy": [
        "utils/adminInfo.js",
        "utils/config.js"
      ],
      "mergeTarget": "config.ADMINBOT",
      "description": "Extra admin UIDs appended to config.ADMINBOT."
    },
    "permissions.ownerUids": {
      "type": "array<string>",
      "format": "uid",
      "default": [],
      "usedBy": [
        "utils/adminInfo.js",
        "utils/config.js"
      ],
      "mergeTarget": [
        "config.ADMINBOT",
        "config.NDH"
      ],
      "description": "Extra owner UIDs appended to both config.ADMINBOT and config.NDH."
    }
  }
}
