# includes/handle/handleCommand.js

handleCommand.userBanned=🚫 Truy cập bị từ chối: Bạn đã bị cấm dùng bot do vi phạm chính sách.\nLý do: %1
handleCommand.threadBanned=⛔️ Nhóm bị cấm: Nhóm này đã bị hạn chế sử dụng bot.\n\n📞 Vui lòng liên hệ quản trị viên để biết thêm.
handleCommand.commandNotExist=⚠️ Lệnh không hợp lệ\n\nLệnh bạn nhập không tồn tại.\nCó phải bạn muốn ⟨ %1 ⟩?\n\nVui lòng kiểm tra lại và thử lại.
handleCommand.commandThreadBanned=🚫 Bị hạn chế: Nhóm của bạn không được phép dùng lệnh "%1".
handleCommand.commandUserBanned=🚫 Bị hạn chế: Bạn không được phép dùng lệnh "%1".
handleCommand.threadNotAllowNSFW=⚠️ NSFW bị hạn chế: Lệnh này không được phép trong nhóm này.
handleCommand.cantGetInfoThread=❌ Lỗi: Không thể lấy thông tin nhóm.\nChi tiết: %1
handleCommand.permssionNotEnough=⛔️ Từ chối quyền\n\nBạn không có quyền cần thiết để dùng lệnh "%1".\nLệnh này chỉ dành cho quản trị viên.
handleCommand.cantSetMessageReaction=❌ Lỗi: Đã xảy ra sự cố không mong muốn khi đặt cảm xúc tin nhắn.\nChi tiết: %1
handleCommand.executeCommand=⚙️ [ %1 ] Lệnh: %2 | Người dùng: %3 | Nhóm: %4 | Tham số: %5 | Thời gian: %6ms
handleCommand.commandError=❌ Lỗi: Đã xảy ra sự cố không mong muốn khi chạy lệnh "%1".\nChi tiết: %2
handleCommand.notApproved=❌ Truy cập bị từ chối: Nhóm này chưa được duyệt dùng bot. Vui lòng liên hệ quản trị viên.
handleCommand.adminOnly=⚠️ Chỉ quản trị viên: Bot hiện đang ở chế độ chỉ quản trị viên.

