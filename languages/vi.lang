# updater.js

updater.latestVersion=✅ Đã cập nhật: Bạn đang dùng phiên bản mới nhất.
updater.cantFindVersion=⚠️ Lỗi phiên bản: Bạn đang dùng phiên bản không xác định (%1). Vui lòng kiểm tra package.json.
updater.newVersions=🔄 Có bản cập nhật: Có %1 phiên bản mới. Đang bắt đầu cập nhật...
updater.updateSuccess=✅ Đã cập nhật: Hệ thống đã cập nhật thành công.%1
